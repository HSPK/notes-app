#include <windows.h>

1 ICON "..\\Shared\\Resources\\Notes.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Notes - local Markdown editor"
            VALUE "FileVersion", "2.0.0"
            VALUE "ProductName", "Notes"
            VALUE "ProductVersion", "2.0.0"
            VALUE "OriginalFilename", "Notes.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
