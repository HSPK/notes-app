<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotesApp.Windows.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Notes Log">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Notes Log">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Notes.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel Grid.Row="1" Margin="24,20,24,12" Spacing="4">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Server log" />
            <TextBlock
                x:Name="PathText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <CommandBar
            Grid.Row="2"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton Click="ReloadClicked" Label="Reload">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Refresh" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Click="ClearClicked" Label="Clear">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Delete" />
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.Content>
                <ToggleSwitch
                    x:Name="AutoScrollToggle"
                    AutomationProperties.Name="Auto-scroll"
                    Header="Auto-scroll"
                    IsOn="True" />
            </CommandBar.Content>
        </CommandBar>

        <Border
            Grid.Row="3"
            Margin="24,8,24,12"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <RichEditBox
                x:Name="LogTextBox"
                AcceptsReturn="True"
                AutomationProperties.Name="Server log content"
                BorderThickness="0"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap"
                />
        </Border>

        <Border
            Grid.Row="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,10">
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="No log yet" />
        </Border>
    </Grid>
</Window>
