<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotesApp.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NotesApp.Windows"
    Title="Notes Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Notes Settings">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/Notes.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            Background="Transparent"
            CompactModeThresholdWidth="641"
            ExpandedModeThresholdWidth="900"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            Loaded="NavigationLoaded"
            OpenPaneLength="260"
            PaneDisplayMode="Auto"
            PaneTitle="Settings"
            SelectionChanged="NavigationSelectionChanged"
            SizeChanged="NavigationSizeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="GeneralNavigationItem"
                    Content="General"
                    Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Server"
                    Tag="server">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Appearance &amp; logs"
                    Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="32,24,32,16" Spacing="5">
                    <TextBlock
                        x:Name="PageTitle"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="General" />
                    <TextBlock
                        x:Name="PageDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="Choose the project location and default apps"
                        TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar
                    x:Name="ValidationInfo"
                    Grid.Row="1"
                    Margin="32,0,32,12"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Check this setting" />

                <Grid Grid.Row="2">
                    <ScrollViewer
                        x:Name="GeneralPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            MaxWidth="900"
                            Padding="32,4,32,24"
                            Spacing="16">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Notes location" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionStyle}"
                                            Text="Choose the project folder that contains your MkDocs configuration." />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="DirectoryTextBox"
                                            AutomationProperties.Name="Project folder"
                                            Header="Project folder"
                                            PlaceholderText="C:\Users\you\Documents\notes"
                                            TextChanged="DirectoryTextChanged" />
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="96"
                                            VerticalAlignment="Bottom"
                                            Click="BrowseClicked"
                                            Content="Browse…" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="DirectoryStatus"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Open with" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionStyle}"
                                            Text="Choose which apps Notes uses for the local site and project files." />
                                    </StackPanel>
                                    <local:SettingRow
                                        Description="Opens the local site"
                                        Header="Browser">
                                        <local:SettingRow.SettingContent>
                                            <ComboBox
                                                x:Name="BrowserCombo"
                                                AutomationProperties.Name="Browser"
                                                HorizontalAlignment="Stretch" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="Opens the project and configuration"
                                        Header="Editor">
                                        <local:SettingRow.SettingContent>
                                            <ComboBox
                                                x:Name="EditorCombo"
                                                AutomationProperties.Name="Editor"
                                                HorizontalAlignment="Stretch" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="Start MkDocs for the current project when Notes launches."
                                        Header="Start automatically">
                                        <local:SettingRow.SettingContent>
                                            <ToggleSwitch
                                                x:Name="AutoStartToggle"
                                                AutomationProperties.Name="Start the server automatically"
                                                HorizontalAlignment="Right"
                                                Toggled="AutoStartToggled" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="Open the local site after the server becomes ready."
                                        Header="Open site after startup">
                                        <local:SettingRow.SettingContent>
                                            <ToggleSwitch
                                                x:Name="AutoOpenBrowserToggle"
                                                AutomationProperties.Name="Open the site when the server is ready"
                                                HorizontalAlignment="Right" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="ServerPage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="900"
                            Padding="32,4,32,24"
                            Spacing="16">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connection" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionStyle}"
                                            Text="The server only listens on the local loopback interface." />
                                    </StackPanel>
                                    <local:SettingRow
                                        Description="Accessible from this PC only"
                                        Header="Listen address">
                                        <local:SettingRow.SettingContent>
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="127.0.0.1" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="TCP port for the local site"
                                        Header="Port">
                                        <local:SettingRow.SettingContent>
                                            <NumberBox
                                                x:Name="PortNumberBox"
                                                AutomationProperties.Name="Port"
                                                HorizontalAlignment="Stretch"
                                                Maximum="65535"
                                                Minimum="1"
                                                SpinButtonPlacementMode="Compact" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="Maximum wait in seconds"
                                        Header="Startup timeout">
                                        <local:SettingRow.SettingContent>
                                            <NumberBox
                                                x:Name="TimeoutNumberBox"
                                                AutomationProperties.Name="Startup timeout"
                                                HorizontalAlignment="Stretch"
                                                Maximum="60"
                                                Minimum="5"
                                                SpinButtonPlacementMode="Compact" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Build behavior" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionStyle}"
                                            Text="These options take effect the next time the server starts." />
                                    </StackPanel>
                                    <local:SettingRow
                                        Description="Refresh the browser when source files change."
                                        Header="Live reload">
                                        <local:SettingRow.SettingContent>
                                            <ToggleSwitch
                                                x:Name="LiveReloadToggle"
                                                AutomationProperties.Name="Live reload"
                                                HorizontalAlignment="Right" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="Rebuild only pages affected by a change."
                                        Header="Only rebuild changed files">
                                        <local:SettingRow.SettingContent>
                                            <ToggleSwitch
                                                x:Name="DirtyReloadToggle"
                                                AutomationProperties.Name="Only rebuild changed files"
                                                HorizontalAlignment="Right" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="Fail the MkDocs build when it emits a warning."
                                        Header="Treat warnings as errors">
                                        <local:SettingRow.SettingContent>
                                            <ToggleSwitch
                                                x:Name="StrictModeToggle"
                                                AutomationProperties.Name="Treat warnings as errors"
                                                HorizontalAlignment="Right" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer
                        x:Name="AppearancePage"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="900"
                            Padding="32,4,32,24"
                            Spacing="16">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="App theme" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionStyle}"
                                            Text="Theme changes are previewed immediately and applied when you save." />
                                    </StackPanel>
                                    <local:SettingRow
                                        Description="Colors used by windows and menus"
                                        Header="Theme">
                                        <local:SettingRow.SettingContent>
                                            <ComboBox
                                                x:Name="ThemeCombo"
                                                AutomationProperties.Name="Theme"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="ThemeSelectionChanged" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Log display" />
                                        <TextBlock
                                            Style="{StaticResource SectionDescriptionStyle}"
                                            Text="The log window shows the latest 4 MB while keeping the full file on disk." />
                                    </StackPanel>
                                    <local:SettingRow
                                        Description="Used by logs and build results"
                                        Header="Text size">
                                        <local:SettingRow.SettingContent>
                                            <ComboBox
                                                x:Name="FontSizeCombo"
                                                AutomationProperties.Name="Log text size"
                                                HorizontalAlignment="Stretch" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                    <local:SettingRow
                                        Description="Use colors embedded in MkDocs output."
                                        Header="ANSI colors">
                                        <local:SettingRow.SettingContent>
                                            <ToggleSwitch
                                                x:Name="AnsiColorsToggle"
                                                AutomationProperties.Name="Show ANSI colors"
                                                HorizontalAlignment="Right" />
                                        </local:SettingRow.SettingContent>
                                    </local:SettingRow>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border
                    Grid.Row="3"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="32,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            x:Name="FallbackControls"
                            Margin="0,0,0,12"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                            <Button
                                x:Name="FallbackServerButton"
                                MinWidth="104"
                                Click="FallbackServerClicked"
                                Content="Start server" />
                            <Button
                                x:Name="FallbackOpenSiteButton"
                                Click="FallbackOpenSiteClicked"
                                Content="Open site" />
                            <Button
                                Click="FallbackViewLogClicked"
                                Content="View log" />
                            <Button Content="More">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            x:Name="FallbackOpenEditorItem"
                                            Click="FallbackOpenEditorClicked"
                                            Text="Open in editor" />
                                        <MenuFlyoutItem
                                            x:Name="FallbackOpenExplorerItem"
                                            Click="FallbackOpenExplorerClicked"
                                            Text="Open in File Explorer" />
                                        <MenuFlyoutItem
                                            x:Name="FallbackOpenConfigurationItem"
                                            Click="FallbackOpenConfigurationClicked"
                                            Text="Open MkDocs configuration" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            x:Name="FallbackBuildItem"
                                            Click="FallbackBuildClicked"
                                            Text="Check documentation" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                x:Name="SaveProgress"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                                <ProgressRing
                                    Width="18"
                                    Height="18"
                                    IsActive="True" />
                                <TextBlock VerticalAlignment="Center" Text="Applying settings…" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="CancelButton"
                                    MinWidth="96"
                                    Click="CancelClicked"
                                    Content="Cancel" />
                                <Button
                                    x:Name="SaveButton"
                                    MinWidth="96"
                                    Click="SaveClicked"
                                    Content="Save"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
